generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//  ENUMS
enum UserRole {
  ADMIN
  USER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum assetStatus {
  OPERATIONAL
  DAMAGED
}

enum WorkOrderStatus {
  OPEN
  COMPLETE
  CLOSED
}

enum ScheduleType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum Category {
  NONE
  ANNUAL_PREVENTIVE_MAINTENANCE
  ASSETS
  LARGE_DAMAGE
  PARTS_REQUEST
  PROJECT_UPGRADE
  SIX_MONTH_PREVENTIVE_MAINTENANCE
  SUPPORT_REQUEST
  WEEKLY_MONTHLY_CHECKLISTS
}

// model user
model User {
  id                 String   @id @default(uuid())
  firstName          String   @map("first_name") @db.VarChar(50)
  lastName           String   @map("last_name") @db.VarChar(50)
  email              String   @db.VarChar(100)
  password           String   @db.VarChar(255)
  @@unique([email, firstName, lastName])
  deviceToken        String?
  notifications      Notification[]
  
  phoneNumber        String?  @map("phone_number") @db.VarChar(20)
  homeAddress        String?        @map("home_address") @db.Text
  profilePicUrl      String?  @map("profile_pic_url") @db.Text
  siteLocation       String?  @map("site_location") @db.VarChar(100)
  designation        String?  @db.VarChar(100)
  teams              Team[]

  role               UserRole       @default(USER)
  approvalStatus     ApprovalStatus @default(PENDING) @map("approval_status")

  createdAt          DateTime @default(now()) @map("created_at")

  organizationId     String   @map("organization_id")
  organization       Organization @relation(fields: [organizationId], references: [orgId], onDelete: Cascade)
  assignedWorkOrders WorkOrder[]     @relation("AssignedTo")
  createdWorkOrders  WorkOrder[]     @relation("CreatedBy")
  autoAssignCategories String[] @default([])

  ownedProjects       Project[]        @relation("ProjectOwner")
  contributedProjects Project[]        @relation("ProjectContributors")
  projectComments     ProjectComment[]
  assignedPms         PreventiveMaintenance[] @relation("PMAssignee")

  comments            Comment[]
  activityLogs        ActivityLog[]
  uploadedDocs        Document[]
  resetCode           String?   @db.VarChar(10)
  resetCodeExpiry     DateTime?

  pin                String?    @db.VarChar(4)

  @@map("users")
}

// model org
model Organization {
  orgId      String      @id @default(uuid())
  orgName    String
  users      User[]
  workOrders WorkOrder[]
  teams      Team[]
  locations  Location[]
  
  projects   Project[]
  preventiveMaintenances PreventiveMaintenance[]
  inventoryParts InventoryPart[]
  assets     Asset[] 
}

// model comment
model Comment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  
  workOrderId Int      @map("work_order_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  
  authorId    String   @map("author_id")
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// Model ActivityLog
model ActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action      String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  workOrderId Int      @map("work_order_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  actorId     String   @map("actor_id")
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

// Model Asset 
model Asset {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @db.VarChar(150)
  description     String?           @db.Text
  model           String?           @db.VarChar(100)
  serialNumber    String?           @map("serial_number") @db.VarChar(100)
  barcode         String?           @db.VarChar(100)
  category        String?           @db.VarChar(100)
  locationName    String?           @map("location_name") @db.VarChar(150)
  status          assetStatus       @default(OPERATIONAL)
  
  uptime          String?           @default("100%") @db.VarChar(50)
  downtime        String?           @default("0 hrs") @db.VarChar(50)
  reliabilityScore String?          @default("A+") @db.VarChar(20)

  organizationId  String?           @map("organization_id")
  organization    Organization?     @relation(fields: [organizationId], references: [orgId], onDelete: Cascade)

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")
  
  workOrders      WorkOrder[]
  parts             InventoryPart[] @relation("AssetParts")
  parents         AssetDependency[] @relation("ChildAsset")
  children        AssetDependency[] @relation("ParentAsset")

  @@map("assets")
}

model AssetDependency {
  parentAssetId  String @map("parent_asset_id") @db.Uuid
  childAssetId   String @map("child_asset_id") @db.Uuid
  dependencyType String @map("dependency_type") @db.VarChar(50)

  parentAsset    Asset  @relation("ParentAsset", fields: [parentAssetId], references: [id], onDelete: Cascade)
  childAsset     Asset  @relation("ChildAsset", fields: [childAssetId], references: [id], onDelete: Cascade)

  @@id([parentAssetId, childAssetId])
  @@map("asset_dependencies")
}

// model workorder
model WorkOrder {
  id             Int             @id @default(autoincrement())
  upkeepId       String?         @map("upkeep_id") // Maps to CSV 'Work Order ID'
  workOrderNumber Int?           @map("work_order_number") // Maps to CSV 'Work Order #'
  title          String          @db.VarChar(150)
  description    String?         @db.Text
  
  priority       Priority        @default(MEDIUM)
  status         WorkOrderStatus @default(OPEN)
  customStatus   String?         @map("custom_status") // Maps to CSV 'Custom Work Order Status'
  category       Category?

  startDate      DateTime?       @map("start_date")
  dueDate        DateTime?       @map("due_date")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  closedAt       DateTime?       @map("closed_at") // Maps to CSV 'Completed On'
  nextDueDate    DateTime?       @map("next_due_date") // Maps to CSV 'Next Due Date'

  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [orgId], onDelete: Cascade)

  // RELATIONS AND FKs
  assetId        String?         @map("asset_id") @db.Uuid
  assignedTo     String?         @map("assigned_to")
  createdBy      String?         @map("created_by")
  teamId         String?         @map("team_id")
  pmId           String?         @map("pm_id")
  parentWorkOrderId Int?         @map("parent_work_order_id")

  asset          Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignee       User?           @relation("AssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator        User?           @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  preventiveMaintenance PreventiveMaintenance? @relation(fields: [pmId], references: [id], onDelete: SetNull)
  parentWorkOrder WorkOrder?     @relation("ParentChildWorkOrder", fields: [parentWorkOrderId], references: [id], onDelete: SetNull)
  childWorkOrders WorkOrder[]    @relation("ParentChildWorkOrder")

  // UPKEEP CSV FLAT DATA COLUMNS
  completedByEmail             String? @map("completed_by_email")
  assignedByEmail              String? @map("assigned_by_email")
  assignedToEmail              String? @map("assigned_to_email")
  additionalAssigneeEmails     String? @map("additional_assignee_emails")
  requestedByEmail             String? @map("requested_by_email")
  teamAssignedName             String? @map("team_assigned_name")
  assetName                    String? @map("asset_name")
  locationName                 String? @map("location_name") @db.VarChar(150)
  assetCategory                String? @map("asset_category")
  
  // JOB DETAILS & COSTS
  estimatedHours               Float?  @map("estimated_hours")
  timeHours                    Float?  @map("time_hours")
  additionalCost               Float?  @map("additional_cost")
  laborCost                    Float?  @map("labor_cost")
  
  // INVENTORY & TASKS
  checklistId                  String? @map("checklist_id")
  taskData                     Json?   @map("task_data") // Stores structured 'Task Data'
  partsNames                   String? @map("parts_names")
  partQuantities               String? @map("part_quantities")
  purchaseOrderNames           String? @map("purchase_order_names")
  fileId                       String? @map("file_id")
  
  // BOOLEAN FLAGS
  requiresSignature            Boolean @default(false) @map("requires_signature")
  isArchived                   Boolean @default(false) @map("is_archived")
  rootWorkOrderExists          Boolean @default(false) @map("root_work_order_exists")
  rescheduleBasedOnCompletion  Boolean @default(false) @map("reschedule_based_on_completion")
  
  // REPEATING SCHEDULES
  repeatingSchedule            String? @map("repeating_schedule")
  stopRepeatingOn              DateTime? @map("stop_repeating_on")

  // RELATED ARRAYS
  comments       Comment[]
  activityLogs   ActivityLog[]
  documents      Document[]

  @@map("work_orders")
}

// model project
model Project {
  id             String           @id @default(uuid())
  projectNumber  Int              @default(autoincrement()) @map("project_number")
  title          String           @db.VarChar(150)
  description    String?          @db.Text
  status         String           @default("ACTIVE")
  startDate      DateTime?        @map("start_date")
  endDate        DateTime?        @map("end_date")
  risks          String[]         @default([])
  decisions      String[]         @default([])
  createdAt      DateTime         @default(now()) @map("created_at")

  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [orgId], onDelete: Cascade)

  ownerId        String           @map("owner_id")
  owner          User             @relation("ProjectOwner", fields: [ownerId], references: [id])

  contributors   User[]           @relation("ProjectContributors")
  comments       ProjectComment[]

  @@map("projects")
}

// Model Project Comment
model ProjectComment {
  id        String   @id @default(uuid())
  text      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("project_comments")
}

// model PM
model PreventiveMaintenance {
  id             String       @id @default(uuid())
  title          String       @db.VarChar(150)
  description    String?      @db.Text
  scheduleType   ScheduleType @default(MONTHLY)
  nextDueDate    DateTime     @map("next_due_date")
  createdAt      DateTime     @default(now()) @map("created_at")

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [orgId], onDelete: Cascade)

  assigneeId     String?      @map("assignee_id")
  assignee       User?        @relation("PMAssignee", fields: [assigneeId], references: [id])

  // MASTER TEMPLATE FIELDS 
  assetId        String?      @map("asset_id") @db.Uuid
  teamId         String?      @map("team_id")
  taskData       Json?        @map("task_data") // Stores the master checklist
  partsData      Json?        @map("parts_data") // Stores required parts & quantities

  workOrders     WorkOrder[]

  @@map("preventive_maintenances")
}

// model site locatiion
model Location {
  id                    String   @id @default(uuid())
  name                  String
  shortName             String?  // NEW FIELD
  address               String?
  longitude             String?
  latitude              String?
  parentLocationName    String?
  parentLocationId      String?
  assignedToEmails      String?
  teamAssignedNames     String?
  customerAssignedNames String?
  vendorAssignedNames   String?
  createdAt             DateTime @default(now())

  organizationId        String?
  organization          Organization? @relation(fields: [organizationId], references: [orgId])
  
  teams                 Team[]
}

// model team
model Team {
  id             String       @id @default(uuid())
  name           String
  description    String?
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [orgId])
  
  locationId     String?
  location       Location?    @relation(fields: [locationId], references: [id])
  
  users          User[]       
  workOrders     WorkOrder[]  // Added backward relation for Work Orders
  
  createdAt      DateTime     @default(now())
}

// model document
model Document {
  id          String   @id @default(uuid())
  fileName    String
  fileUrl     String
  createdAt   DateTime @default(now()) @map("created_at")

  workOrderId Int      @map("work_order_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  uploaderId  String   @map("uploader_id")
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// model InventoryPart
model InventoryPart {
  id              String   @id @default(uuid())
  name            String
  partNumber      String?
  description     String?
  category        String?
  cost            Float    @default(0)
  barcode         String?
  tags            String?
  isNonStock      Boolean  @default(false)
  isCritical      Boolean  @default(false)
  availableQty    Int      @default(0)
  minQty          Int      @default(0)
  maxQtyThreshold Int      @default(0)
  siteLocation    String?
  area            String?
  imageUrls       String[] @default([])

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [orgId])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  assets          Asset[]         @relation("AssetParts")
}

// systemAuditlog for Admin and Users(for developer mode debug only)
model SystemAuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  userName       String
  role           String   // 'ADMIN' or 'USER'
  action         String
  details        String
  createdAt      DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  isRead      Boolean  @default(false)
  type        String   // e.g., 'WORK_ORDER', 'MENTION'
  referenceId String?  // ID of the work order
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}